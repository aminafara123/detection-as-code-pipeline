# Only the `draft` command uses an LLM; everything else runs fully offline.
# Defaults point at a local Ollama OpenAI-compatible endpoint. Copy to .env and
# edit if you use a different model or a hosted provider. Never commit a real key.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_API_KEY=ollama
